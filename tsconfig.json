{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "**/*.ts", "prisma/seed.ts"],
  "exclude": ["node_modules", "src/tests/**/*", "src/**/*.test.ts"]
}
