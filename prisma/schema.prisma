generator client {
  provider = "prisma-client"
  output   = "../src/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  extensions = [vector]
}

enum Role {
  ADMIN
  COMPANY
  STUDENT
  PSYCHOLOGIST
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviews Interview[]
  answers    Answer[]
}

model Company {
  id   Int    @id @default(autoincrement())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviews Interview[]
  positions Position[]
}

model Position {
  id   Int    @id @default(autoincrement())
  companyId Int
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviews Interview[]
  company Company @relation(fields: [companyId], references: [id])
}

enum Status {
  ONGOING
  FINISH
}

model Interview {
  id         Int     @id @default(autoincrement())
  userId     Int
  companyId  Int
  positionId Int
  status    Status?
  resume    String?
  finalResume String?
  resumePrompt String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  company  Company  @relation(fields: [companyId], references: [id])
  position Position @relation(fields: [positionId], references: [id])
  answers  Answer[]
  chatHistories ChatHistory[]
  focusQuestions FocusQuestion[]
}

enum QuestionType {
  INTRO
  GENERAL
  TECHNICAL
  SOFTSKILL
}

model Question {
  id         Int          @id @default(autoincrement())
  content    String
  difficulty String?
  type       QuestionType @default(GENERAL)
  categoryId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers     Answer[]
  keywords    Keyword[]
  idealAnswer IdealAnswer[]
  categories  AnswerCategory[]

  category QuestionCategory @relation(fields: [categoryId], references: [id])
  chatHistories ChatHistory[]

  @@index([categoryId])
}

model QuestionCategory {
  id   Int    @id @default(autoincrement())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]
  focusQuestions FocusQuestion[]
}

model AnswerCategory {
  id         Int @id @default(autoincrement())
  questionId Int

  label String // "Mudah beradaptasi"
  score Int // 4

  question     Question     @relation(fields: [questionId], references: [id])
  scores       Score[]
  idealAnswers IdealAnswer[]
}

model Answer {
  id          Int    @id @default(autoincrement())
  questionId  Int
  interviewId Int
  userId      Int
  content     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question  Question     @relation(fields: [questionId], references: [id])
  interview Interview    @relation(fields: [interviewId], references: [id])
  user      User         @relation(fields: [userId], references: [id])
  score     Score?
  idealAnswers IdealAnswer[]

  @@index([questionId])
  @@index([interviewId])
}

model Keyword {
  id         Int    @id @default(autoincrement())
  questionId Int
  word       String
  weight     Float  @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id])
}

model IdealAnswer {
  id         Int    @id @default(autoincrement())
  questionId Int
  answerCategoryId Int?
  content    String
  embedding  Unsupported("vector")

  sourceAnswerId Int?
  
  isApproved     Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question         Question         @relation(fields: [questionId], references: [id])
  answerCategories AnswerCategory? @relation(fields: [answerCategoryId], references: [id])
  sourceAnswer     Answer?          @relation(fields: [sourceAnswerId], references: [id])
}

model Score {
  id       Int @id @default(autoincrement())
  answerId Int @unique

  type     QuestionType

  // General Fields
  finalScore      Float
  similarityScore Float @default(0)
  keywordScore    Float @default(0)
  confidenceScore Float

  feedback        String?
  reason          String?
  breakdown       Json?
  promptRubric    String?
  promptCategory  String?

  // Specific to Technical
  rubricScore     Float?

  // Specific to Soft Skill
  categoryId      Int?
  categoryScore   Int?
  categoryLabel   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answer   Answer         @relation(fields: [answerId], references: [id])
  category AnswerCategory? @relation(fields: [categoryId], references: [id])
}

enum ChatRole {
  AI
  USER
}

model ChatHistory {
  id          Int      @id @default(autoincrement())
  interviewId Int
  role        ChatRole
  content     String
  prompt      String?
  questionId  Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  interview   Interview @relation(fields: [interviewId], references: [id])
  question    Question? @relation(fields: [questionId], references: [id])
}

model FocusQuestion {
  interviewId Int
  categoryId  Int

  interview   Interview        @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  category    QuestionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([interviewId, categoryId])
}