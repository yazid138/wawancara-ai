generator client {
  provider = "prisma-client"
  output   = "../src/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COMPANY
  STUDENT
  PSYCHOLOGIST
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviews Interview[]
  answers    Answer[]
}

model Company {
  id   Int    @id @default(autoincrement())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviews Interview[]
}

model Position {
  id   Int    @id @default(autoincrement())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviews Interview[]
}

enum Status {
  ONGOING
  FINISH
}

model Interview {
  id         Int     @id @default(autoincrement())
  userId     Int
  companyId  Int
  positionId Int
  status    Status?
  currentIndex Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  company  Company  @relation(fields: [companyId], references: [id])
  position Position @relation(fields: [positionId], references: [id])
  answers  Answer[]
}

enum QuestionType {
  INTRO
  GENERAL
  TECHNICAL
  BEHAVIORAL
  SOFTSKILL
}

model Question {
  id         Int          @id @default(autoincrement())
  content    String
  difficulty String?
  type       QuestionType @default(GENERAL)
  categoryId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers     Answer[]
  keywords    Keyword[]
  idealAnswer IdealAnswer?
  categories  AnswerCategory[]

  category QuestionCategory @relation(fields: [categoryId], references: [id])
}

model QuestionCategory {
  id   Int    @id @default(autoincrement())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]
}

model AnswerCategory {
  id         Int @id @default(autoincrement())
  questionId Int

  label String // "Mudah beradaptasi"
  score Int // 4

  question     Question     @relation(fields: [questionId], references: [id])
  scoreAnswers ScoreAnswer?
}

model Answer {
  id          Int    @id @default(autoincrement())
  questionId  Int
  interviewId Int
  userId      Int
  content     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question  Question     @relation(fields: [questionId], references: [id])
  interview Interview    @relation(fields: [interviewId], references: [id])
  user      User         @relation(fields: [userId], references: [id])
  score     ScoreAnswer?
}

model Keyword {
  id         Int    @id @default(autoincrement())
  questionId Int
  word       String
  weight     Float  @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id])
}

model IdealAnswer {
  id         Int    @id @default(autoincrement())
  questionId Int    @unique
  content    String
  embedding  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id])
}

model ScoreAnswer {
  id       Int @id @default(autoincrement())
  answerId Int @unique

  scores     Json // { rubric: 8, similarity: 7, keyword: 6 }
  finalScore Float

  categoryId    Int     @unique
  categoryLabel String?

  breakdown Json?
  feedback  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answer   Answer         @relation(fields: [answerId], references: [id])
  category AnswerCategory @relation(fields: [categoryId], references: [id])
}
