generator client {
  provider = "prisma-client"
  output   = "../src/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COMPANY
  STUDENT
  PSYCHOLOGIST
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviews Interview[]
  answers    Answer[]
}

model Company {
  id   Int    @id @default(autoincrement())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviews Interview[]
  positions Position[]
}

model Position {
  id   Int    @id @default(autoincrement())
  companyId Int
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviews Interview[]
  company Company @relation(fields: [companyId], references: [id])
}

enum Status {
  ONGOING
  FINISH
}

model Interview {
  id         Int     @id @default(autoincrement())
  userId     Int
  companyId  Int
  positionId Int
  status    Status?
  currentIndex Int     @default(0)
  resume    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  company  Company  @relation(fields: [companyId], references: [id])
  position Position @relation(fields: [positionId], references: [id])
  answers  Answer[]
  chatHistories ChatHistory[]
}

enum QuestionType {
  INTRO
  GENERAL
  TECHNICAL
  SOFTSKILL
}

model Question {
  id         Int          @id @default(autoincrement())
  content    String
  difficulty String?
  type       QuestionType @default(GENERAL)
  categoryId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers     Answer[]
  keywords    Keyword[]
  idealAnswer IdealAnswer[]
  categories  AnswerCategory[]

  category QuestionCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
}

model QuestionCategory {
  id   Int    @id @default(autoincrement())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]
}

model AnswerCategory {
  id         Int @id @default(autoincrement())
  questionId Int

  label String // "Mudah beradaptasi"
  score Int // 4

  question     Question     @relation(fields: [questionId], references: [id])
  ScoreSoftSkill ScoreSoftSkill[]
}

model Answer {
  id          Int    @id @default(autoincrement())
  questionId  Int
  interviewId Int
  userId      Int
  content     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question  Question     @relation(fields: [questionId], references: [id])
  interview Interview    @relation(fields: [interviewId], references: [id])
  user      User         @relation(fields: [userId], references: [id])
  technicalScore ScoreTechnical?
  softSkillScore ScoreSoftSkill?

  @@index([questionId])
  @@index([interviewId])
}

model Keyword {
  id         Int    @id @default(autoincrement())
  questionId Int
  word       String
  weight     Float  @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id])
}

model IdealAnswer {
  id         Int    @id @default(autoincrement())
  questionId Int    
  content    String
  embedding  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id])
}

model ScoreTechnical {
  id       Int @id @default(autoincrement())
  answerId Int @unique

  rubricScore     Float
  similarityScore Float
  keywordScore    Float

  finalScore Float

  confidenceScore Float

  feedback  String?
  reason    String?
  breakdown Json?
  prompt    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answer Answer @relation(fields: [answerId], references: [id])
}


model ScoreSoftSkill {
  id       Int @id @default(autoincrement())
  answerId Int @unique

  categoryId    Int?
  categoryLabel String

  finalScore Float
  reason     String?

  confidenceScore Float
  prompt          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answer   Answer         @relation(fields: [answerId], references: [id])
  category AnswerCategory? @relation(fields: [categoryId], references: [id])
}

enum ChatRole {
  AI
  USER
}

model ChatHistory {
  id          Int      @id @default(autoincrement())
  interviewId Int
  role        ChatRole
  content     String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  interview   Interview @relation(fields: [interviewId], references: [id])
}