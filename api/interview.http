@hostname = http://localhost
@port = 5000
@host = {{hostname}}:{{port}}
@username = admin
@password = admin
@Content-Type = application/json

### Login
# @name login
@authToken = {{login.response.body.data.token}}
POST {{host}}/auth/login
Content-Type: {{Content-Type}}

{
    "username": "{{username}}",
    "password": "{{password}}"
}

### Create Interview
# @name createInterview
@interviewId = {{createInterview.response.body.data.id}}

POST {{host}}/interviews
Authorization: Bearer {{authToken}}
Content-Type: {{Content-Type}}

{
  "companyId": 1,
  "positionId": 1
}

### Get Questions
# @name getQuestions
GET {{host}}/interviews/{{interviewId}}/questions
Authorization: Bearer {{authToken}}

### Get Current Question
# @name current1
GET {{host}}/interviews/{{interviewId}}/current
Authorization: Bearer {{authToken}}

### Submit Answer
POST {{host}}/answers
Authorization: Bearer {{authToken}}
Content-Type: {{Content-Type}}

{
  "interviewId": {{interviewId}},
  "answer": "Saya adalah backend developer dengan pengalaman 3 tahun..."
}

### Get Next Question
@name next1
GET {{host}}/interviews/{{interviewId}}/next
Authorization: Bearer {{authToken}}

### Get Current Question Again
GET {{host}}/interviews/{{interviewId}}/current
Authorization: Bearer {{authToken}}

### Submit Answer Again
POST {{host}}/answers
Authorization: Bearer {{authToken}}
Content-Type: {{Content-Type}}

{
  "interviewId": {{interviewId}},
  "answer": "Saya memiliki pengalaman bekerja dengan Node.js, Express, dan MongoDB..."
}

### Next Question Again
GET {{host}}/interviews/{{interviewId}}/next
Authorization: Bearer {{authToken}}

### Finish Interview
GET {{host}}/interviews/{{interviewId}}/finish
Authorization: Bearer {{authToken}}

### Get Result
GET {{host}}/interviews/{{interviewId}}/result
Authorization: Bearer {{authToken}}
